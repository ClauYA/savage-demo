<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>21 Savage Fans</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="font-awesome.min.css">
    
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header>
        <nav>
            
            <h3>21 Savage</h3>                  
           
            <ul class="nav justify-content-end">
                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/">Message board</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Add a Message</a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/signup">Get Started</a>
                </li>
            </ul>
        </nav>
    </header>
  <main>
    <section class="container-headline">
      <h1>Why you trappin so hard?</h1>
      <h3>A space for the fans. Leave a thought. Keep the conversation going.</h3>
    </section>
    <section class="container-messages">
      <h3>Messages</h3>
      <ul class="messages">
      <% for(var i=0; i<messages.length; i++) {%>
      <li class="message">
        <span><%= messages[i].name %></span>
        <span><%= messages[i].msg %></span>
        <span><%= messages[i].thumbUp + messages[i].thumbDown%></span>
        
        <span><i data-like="<%= messages[i].thumbUp %>" class="fa fa-thumbs-up" aria-hidden="true"></i></span>
        
        <span><i data-unlike="<%= messages[i].thumbDown %>" class="fa fa-thumbs-down" aria-hidden="true"></i></span>
        <span><i class="fa fa-trash" aria-hidden="true"></i></span>
      </li>
    <% } %>
      </ul>
    <section class="container-add-messages">  
      <h2>Add a message</h2>
      <p>Got something to say? You’re in the right place.</p>
      <form action="/messages" method="POST">
         <div class="form-field">
            <label for="email12" class="form-label" >Name</label>
            <input type="text" class="form-control input-messa" id="email12" name="name" placeholder="name">
          </div>
           <div class="form-field">
            <label for="email12" class="form-label">Message</label>
            <textarea type="text" class="form-control" id="email12" name="msg" placeholder="name"></textarea>
          </div>
        <button type="submit">Submit</button>
      </form>
    </section>
    </section>
  </main>
  <script src="main.js"></script>
</body>
</html>
